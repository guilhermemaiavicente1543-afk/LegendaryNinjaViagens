* {
  box-sizing: border-box;
}

html,
body,
#root {
  margin: 0;
  width: 100%;
  height: 100%;
}

body {
  font-family: Arial, sans-serif;
  background: #111827;
}

.app {
  display: grid;
  grid-template-columns: 370px 1fr;
  height: 100vh;
  width: 100vw;
  overflow: hidden;
}

.panel {
  padding: 20px;
  background: #111827;
  color: white;
  border-right: 1px solid #374151;
  z-index: 1000;
  overflow-y: auto;
}

.panelHeader {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.panel h1 {
  margin: 0 0 12px;
  font-size: 28px;
}

.panel p {
  color: #d1d5db;
  line-height: 1.5;
}

.panel label {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin: 18px 0;
  font-weight: bold;
}

.panel select,
.panel button,
.panel input {
  padding: 10px;
  font-size: 15px;
}

.panel select,
.panel button {
  border: 0;
  border-radius: 8px;
}

.panel button {
  cursor: pointer;
  background: #f97316;
  color: white;
  font-weight: bold;
  width: 100%;
}

.panel button:hover {
  filter: brightness(1.08);
}

.checkboxRow {
  flex-direction: row !important;
  align-items: center;
  gap: 10px !important;
}

.checkboxRow input {
  width: auto;
}

.info,
.result,
.hint,
.ruleBox {
  margin-top: 18px;
  padding: 14px;
  background: #1f2937;
  border: 1px solid #374151;
  border-radius: 12px;
  line-height: 1.6;
}

.ruleBox {
  border-color: #f97316;
}

.result {
  font-size: 17px;
  background: #172554;
  border-color: #2563eb;
}

.hint {
  color: #d1d5db;
  font-size: 14px;
}

.mapArea {
  height: 100vh;
  width: 100%;
  background: #0f172a;
}

.leaflet-container {
  height: 100%;
  width: 100%;
  background: #0f172a;
}

.leaflet-control-attribution {
  display: none;
}

.mobileConfigButton,
.mobileCloseButton,
.panelBackdrop {
  display: none;
}

@media (max-width: 768px) {
  .app {
    display: block;
    height: 100dvh;
    width: 100vw;
  }

  .mapArea {
    height: 100dvh;
    width: 100vw;
  }

  .mobileConfigButton {
    display: block;
    position: fixed;
    top: 12px;
    left: 12px;
    z-index: 2000;
    border: 0;
    border-radius: 999px;
    background: #f97316;
    color: white;
    font-weight: bold;
    padding: 10px 14px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
  }

  .panel {
    position: fixed;
    top: 0;
    left: 0;
    width: min(88vw, 370px);
    height: 100dvh;
    border-right: 1px solid #374151;
    transform: translateX(-105%);
    transition: transform 180ms ease;
    box-shadow: 12px 0 30px rgba(0, 0, 0, 0.45);
    padding-bottom: 90px;
  }

  .panel.panelOpen {
    transform: translateX(0);
  }

  .mobileCloseButton {
    display: block;
    width: auto !important;
    min-width: 42px;
    background: #374151 !important;
    padding: 8px 12px !important;
  }

  .panelBackdrop {
    display: block;
    position: fixed;
    inset: 0;
    z-index: 900;
    border: 0;
    background: rgba(0, 0, 0, 0.35);
    padding: 0;
  }

  .panel h1 {
    font-size: 24px;
  }

  .panel select,
  .panel button,
  .panel input {
    font-size: 16px;
  }
}

.navigationTabs {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
  margin: 18px 0;
}

.panel .navigationTabs button {
  background: #374151;
}

.panel .navigationTabs button.activeTab {
  background: #f97316;
}

.characters-page {
  min-height: 100%;
  width: 100%;
  overflow-y: auto;
  padding: 32px;
  color: #f9fafb;
  background:
    radial-gradient(circle at top left, rgba(249, 115, 22, 0.18), transparent 34%),
    #0f172a;
}

.characters-header {
  max-width: 1100px;
  margin: 0 auto 24px;
}

.characters-header h1 {
  margin: 0;
  font-size: 36px;
}

.characters-header p {
  color: #d1d5db;
  line-height: 1.6;
}

.eyebrow {
  color: #f97316 !important;
  text-transform: uppercase;
  letter-spacing: 0.16em;
  font-size: 12px;
  font-weight: 800;
}

.characters-layout {
  max-width: 1100px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: minmax(0, 1.15fr) minmax(320px, 0.85fr);
  gap: 24px;
  align-items: start;
}

.character-form,
.characters-list,
.character-card {
  background: rgba(17, 24, 39, 0.92);
  border: 1px solid #374151;
  border-radius: 18px;
  box-shadow: 0 18px 60px rgba(0, 0, 0, 0.28);
}

.character-form,
.characters-list {
  padding: 22px;
}

.character-form h2,
.characters-list h2 {
  margin-top: 0;
}

.character-form label {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin: 14px 0;
  color: #f9fafb;
  font-weight: 700;
}

.character-form input,
.character-form textarea,
.character-form select,
.trait-filters input,
.trait-filters select {
  width: 100%;
  border: 1px solid #4b5563;
  border-radius: 10px;
  background: #0f172a;
  color: #f9fafb;
  padding: 11px 12px;
  font-size: 15px;
}

.character-form textarea {
  min-height: 96px;
  resize: vertical;
}

.trait-selector {
  margin-top: 20px;
  padding: 16px;
  border: 1px solid #374151;
  border-radius: 16px;
  background: #111827;
}

.trait-selector h3 {
  margin-top: 0;
}

.trait-filters {
  display: grid;
  grid-template-columns: 1fr 150px 130px;
  gap: 10px;
}

.trait-results {
  display: grid;
  gap: 10px;
  margin-top: 12px;
}

.trait-result {
  text-align: left;
  border: 1px solid #374151;
  border-radius: 12px;
  background: #1f2937;
  color: #f9fafb;
  padding: 12px;
  cursor: pointer;
}

.trait-result:hover {
  border-color: #f97316;
}

.trait-result strong {
  display: block;
  margin-bottom: 4px;
}

.trait-result span {
  color: #d1d5db;
  font-size: 13px;
}

.selected-traits {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 14px;
}

.selected-traits p,
.empty-message {
  color: #9ca3af;
}

.selected-trait {
  border: 1px solid #f97316;
  border-radius: 999px;
  background: rgba(249, 115, 22, 0.14);
  color: #fed7aa;
  padding: 8px 11px;
  cursor: pointer;
}

.save-character-button {
  width: 100%;
  margin-top: 18px;
  border: 0;
  border-radius: 12px;
  background: #f97316;
  color: white;
  padding: 13px 16px;
  font-weight: 800;
  font-size: 16px;
  cursor: pointer;
}

.save-character-button:hover {
  filter: brightness(1.08);
}

.characters-list {
  position: sticky;
  top: 24px;
}

.character-card {
  padding: 16px;
  margin-top: 14px;
}

.character-card-header {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  align-items: start;
}

.character-card h3 {
  margin: 0;
}

.character-card-header p {
  margin: 6px 0 0;
  color: #d1d5db;
}

.character-card-header button {
  border: 0;
  border-radius: 10px;
  background: #7f1d1d;
  color: white;
  padding: 8px 10px;
  cursor: pointer;
}

.character-card p {
  color: #e5e7eb;
  line-height: 1.5;
}

.card-traits {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 12px;
}

.card-traits span {
  border-radius: 999px;
  background: #1e3a8a;
  color: #bfdbfe;
  padding: 6px 9px;
  font-size: 13px;
}

@media (max-width: 900px) {
  .characters-page {
    padding: 22px 14px;
  }

  .characters-layout {
    grid-template-columns: 1fr;
  }

  .characters-list {
    position: static;
  }

  .trait-filters {
    grid-template-columns: 1fr;
  }

  .characters-header h1 {
    font-size: 28px;
  }
}

/* Correção de rolagem da página de personagens */
.mapArea {
  overflow: hidden;
}

.characters-page {
  height: 100vh;
  max-height: 100vh;
  overflow-y: auto;
  overflow-x: hidden;
  padding-bottom: 80px;
}

@media (max-width: 768px) {
  .characters-page {
    height: 100dvh;
    max-height: 100dvh;
    padding-bottom: 110px;
  }
}

.travelBox,
.travelList {
  margin-top: 18px;
  padding: 14px;
  background: #111827;
  border: 1px solid #f97316;
  border-radius: 12px;
  line-height: 1.5;
}

.travelBox strong,
.travelList strong {
  color: #fed7aa;
}

.travelSmallText {
  color: #d1d5db;
  font-size: 13px;
  margin-bottom: 0;
}

.travelItem {
  margin-top: 12px;
  padding: 12px;
  background: #1f2937;
  border: 1px solid #374151;
  border-radius: 10px;
  color: #e5e7eb;
}

.travelItem button {
  margin-top: 10px;
  background: #7f1d1d !important;
}

.characterMapIconWrapper {
  background: transparent;
  border: 0;
}

.characterMapIcon {
  width: 36px;
  height: 36px;
  display: grid;
  place-items: center;
  border-radius: 999px;
  background: #f97316;
  color: white;
  border: 3px solid #ffffff;
  font-weight: 900;
  font-size: 18px;
  box-shadow: 0 0 18px rgba(249, 115, 22, 0.9);
}

.characterMapIcon.moving {
  animation: characterPulse 1.4s infinite;
}

.characterMapIcon.arrived {
  background: #22c55e;
  box-shadow: 0 0 18px rgba(34, 197, 94, 0.9);
}

@keyframes characterPulse {
  0% {
    transform: scale(1);
  }

  50% {
    transform: scale(1.12);
  }

  100% {
    transform: scale(1);
  }
}

