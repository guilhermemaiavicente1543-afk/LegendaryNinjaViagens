html,
body,
#root {
  width: 100%;
  min-height: 100%;
  overflow-x: hidden;
}

* {
  box-sizing: border-box;
}

button,
input,
select,
textarea {
  font-size: 16px;
}

@supports (height: 100dvh) {
  .app,
  .auth-page,
  .admin-page,
  .skill-tree-page,
  .player-skill-tree-page,
  .ln-shell {
    min-height: 100dvh;
  }
}

