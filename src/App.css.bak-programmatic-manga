    radial-gradient(circle at 80% 20%, rgba(185, 28, 28, 0.24), transparent 24%),
    linear-gradient(120deg, #020617, #050505 52%, #111827);
}

.ln-shinobi-v2::before {
  opacity: 0.42;
  filter: grayscale(0.95) contrast(1.55) brightness(0.8);
}

.ln-shinobi-v2::after {
  background:
    linear-gradient(112deg, transparent 0 58%, rgba(249, 115, 22, 0.88) 58% 64%, transparent 64%),
    linear-gradient(20deg, transparent 0 72%, rgba(249, 115, 22, 0.55) 72% 75%, transparent 75%),
    radial-gradient(circle at 50% 52%, transparent 0 16%, rgba(0, 0, 0, 0.55) 38%, rgba(0, 0, 0, 0.95) 100%);
}

.ln-eye-card {
  position: absolute;
  top: 126px;
  left: 300px;
  z-index: 4;
  display: grid;
  gap: 8px;
  justify-items: center;
  padding: 14px;
  border: 2px solid rgba(249, 115, 22, 0.68);
  background: rgba(3, 7, 18, 0.72);
  box-shadow: 0 18px 55px rgba(0, 0, 0, 0.55);
  transform: rotate(-3deg);
}

.ln-eye-card p {
  margin: 0;
  color: #fed7aa;
  font-size: 11px;
  font-weight: 950;
  text-transform: uppercase;
  letter-spacing: 0.12em;
}

.ln-red-eye {
  position: relative;
  width: 104px;
  height: 54px;
  border-radius: 999px;
  background:
    radial-gradient(circle at 50% 50%, #020617 0 8px, #7f1d1d 9px 15px, #dc2626 16px 31px, #111827 32px);
  border: 4px solid #050505;
  box-shadow:
    inset 0 0 16px rgba(0, 0, 0, 0.95),
    0 0 28px rgba(220, 38, 38, 0.75);
  overflow: hidden;
}

.ln-red-eye::before {
  content: "";
  position: absolute;
  inset: 8px 18px;
  border-radius: 50%;
  border: 2px solid rgba(5, 5, 5, 0.8);
}

.ln-red-eye::after {
  content: "";
  position: absolute;
  inset: 0;
  background:
    linear-gradient(12deg, rgba(255,255,255,0.24), transparent 36%),
    linear-gradient(180deg, rgba(0,0,0,0.35), transparent 45%, rgba(0,0,0,0.6));
}

.ln-red-eye.small {
  width: 132px;
  height: 76px;
}

.tomoe {
  position: absolute;
  z-index: 2;
  width: 9px;
  height: 9px;
  border-radius: 999px;
  background: #020617;
  box-shadow: 0 0 0 2px rgba(2, 6, 23, 0.75);
}

.tomoe::after {
  content: "";
  position: absolute;
  width: 12px;
  height: 6px;
  border-radius: 999px;
  background: #020617;
  top: 5px;
  left: 3px;
  transform: rotate(42deg);
}

.tomoe.one {
  top: 13px;
  left: 49px;
}

.tomoe.two {
  top: 30px;
  left: 34px;
  transform: rotate(120deg);
}

.tomoe.three {
  top: 30px;
  right: 34px;
  transform: rotate(240deg);
}

.ln-eye-panel {
  background:
    radial-gradient(circle at 52% 48%, rgba(220, 38, 38, 0.95), transparent 22%),
    linear-gradient(135deg, rgba(229, 231, 235, 0.82), rgba(17, 24, 39, 0.86)) !important;
}

.ln-scroll-emblem {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18px;
}

.ln-scroll-emblem .scroll {
  display: grid;
  place-items: center;
  width: 68px;
  height: 156px;
  border-radius: 28px;
  border: 4px solid #111827;
  outline: 2px solid rgba(249, 115, 22, 0.75);
  background:
    linear-gradient(90deg, #92400e, #fed7aa 42%, #92400e);
  color: #020617;
  font-weight: 950;
  writing-mode: vertical-rl;
  font-size: 24px;
  box-shadow: 0 18px 50px rgba(0, 0, 0, 0.55);
}

.ln-ninja-silhouette {
  position: absolute;
  z-index: 3;
  width: 160px;
  height: 260px;
  opacity: 0.92;
  filter: drop-shadow(0 20px 30px rgba(0, 0, 0, 0.8));
}

.ln-ninja-silhouette .head,
.ln-ninja-silhouette .body,
.ln-ninja-silhouette .scarf,
.ln-ninja-silhouette .blade {
  position: absolute;
  display: block;
  background: #030712;
}

.ln-ninja-silhouette .head {
  width: 46px;
  height: 46px;
  border-radius: 999px;
  left: 56px;
  top: 12px;
  border: 2px solid rgba(249, 115, 22, 0.45);
}

.ln-ninja-silhouette .body {
  width: 86px;
  height: 146px;
  left: 36px;
  top: 58px;
  clip-path: polygon(50% 0, 86% 16%, 100% 82%, 68% 100%, 28% 100%, 0 82%, 14% 16%);
  border-bottom: 4px solid #f97316;
}

.ln-ninja-silhouette .scarf {
  width: 110px;
  height: 22px;
  left: 78px;
  top: 62px;
  background: #f97316;
  clip-path: polygon(0 28%, 100% 0, 76% 100%, 0 72%);
}

.ln-ninja-silhouette .blade {
  width: 150px;
  height: 8px;
  left: 14px;
  top: 94px;
  background: #d1d5db;
  transform: rotate(-32deg);
  box-shadow: 0 0 16px rgba(255, 255, 255, 0.25);
}

.left-ninja {
  left: 270px;
  bottom: 82px;
  transform: scale(0.92) rotate(-4deg);
}

.right-ninja {
  right: 195px;
  bottom: 82px;
  transform: scale(1.05) rotate(4deg);
}

.right-ninja .scarf {
  left: -42px;
  transform: scaleX(-1);
}

.ln-hero-description {
  background: rgba(3, 7, 18, 0.58);
  border: 1px solid rgba(249, 115, 22, 0.22);
  padding: 12px 18px;
  border-radius: 0;
  backdrop-filter: blur(4px);
}

.ln-hero h1 {
  position: relative;
}

.ln-hero h1::before,
.ln-hero h1::after {
  content: "";
  position: absolute;
  height: 12px;
  background: #f97316;
  transform: skewX(-22deg);
  box-shadow: 0 0 24px rgba(249, 115, 22, 0.8);
}

.ln-hero h1::before {
  left: 6%;
  right: 68%;
  top: -18px;
}

.ln-hero h1::after {
  left: 68%;
  right: 6%;
  bottom: -20px;
}

@media (max-width: 1200px) {
  .ln-eye-card,
  .ln-ninja-silhouette {
    display: none;
  }

  .ln-scroll-emblem .scroll {
    display: none;
  }
}

@media (max-width: 700px) {
  .ln-shinobi-v2 .ln-hero {
    padding-top: 72px;
  }

  .ln-red-eye.small {
    width: 98px;
    height: 58px;
  }
}

