/* Hall estável restaurado */
.entry-hall-page {
  min-height: 100vh;
  display: grid;
  place-items: center;
  padding: 24px;
  background:
    radial-gradient(circle at 20% 10%, rgba(249, 115, 22, 0.16), transparent 28%),
    radial-gradient(circle at 85% 70%, rgba(249, 115, 22, 0.12), transparent 30%),
    #020617;
}

.entry-hall-card {
  width: min(1100px, 100%);
  padding: 34px;
  border-radius: 28px;
  background: rgba(17, 24, 39, 0.96);
  border: 1px solid #374151;
  box-shadow: 0 24px 80px rgba(0, 0, 0, 0.42);
}

.entry-hall-card h1 {
  margin: 0;
  color: #f9fafb;
  font-size: clamp(34px, 6vw, 68px);
  line-height: 0.95;
}

.entry-hall-card > p {
  color: #d1d5db;
  max-width: 680px;
}

.entry-user-box {
  display: grid;
  gap: 4px;
  margin: 22px 0;
  padding: 14px 16px;
  border-radius: 16px;
  background: #0f172a;
  border: 1px solid #374151;
}

.entry-user-box span {
  color: #9ca3af;
  font-size: 13px;
  font-weight: 800;
}

.entry-user-box strong {
  color: #fed7aa;
}

.entry-actions {
  display: grid;
  gap: 16px;
  margin-top: 24px;
}

.entry-actions-three {
  grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
}

.entry-actions button {
  min-height: 160px;
  display: grid;
  align-content: center;
  gap: 10px;
  padding: 22px;
  border: 1px solid rgba(249, 115, 22, 0.5);
  border-radius: 22px;
  background: linear-gradient(180deg, #1f2937, #111827);
  color: #f9fafb;
  font-size: 24px;
  font-weight: 950;
  cursor: pointer;
  text-align: left;
}

.entry-actions button:hover {
  transform: translateY(-2px);
  border-color: #f97316;
  box-shadow: 0 16px 40px rgba(249, 115, 22, 0.16);
}

.entry-actions button span {
  color: #d1d5db;
  font-size: 14px;
  font-weight: 700;
  line-height: 1.45;
}

.entry-logout-button {
  margin-top: 22px;
  border: 0;
  border-radius: 999px;
  background: #f97316;
  color: white;
  padding: 10px 18px;
  font-weight: 900;
  cursor: pointer;
}

@media (max-width: 900px) {
  .entry-actions-three {
    grid-template-columns: 1fr !important;
  }

  .entry-hall-card {
    padding: 22px;
  }

  .entry-actions button {
    min-height: 120px;
  }
}
