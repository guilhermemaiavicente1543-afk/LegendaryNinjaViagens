.ln-landing {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  color: #f8fafc;
  background:
    radial-gradient(circle at 50% 42%, rgba(249, 115, 22, 0.24), transparent 22%),
    radial-gradient(circle at 72% 48%, rgba(255, 255, 255, 0.08), transparent 20%),
    linear-gradient(120deg, rgba(2, 6, 23, 0.75), rgba(2, 6, 23, 0.95)),
    #020617;
  isolation: isolate;
}

.ln-landing::before {
  content: "";
  position: absolute;
  inset: 78px 0 0;
  z-index: -3;
  background:
    linear-gradient(90deg, rgba(0, 0, 0, 0.65), transparent 28%, transparent 70%, rgba(0, 0, 0, 0.72)),
    url("/mapa-limpo.png");
  background-size: cover;
  background-position: center;
  opacity: 0.34;
  filter: grayscale(0.8) contrast(1.35);
}

.ln-landing::after {
  content: "";
  position: absolute;
  inset: 0;
  z-index: -2;
  pointer-events: none;
  background:
    linear-gradient(105deg, transparent 0 66%, rgba(249, 115, 22, 0.82) 66% 72%, transparent 72%),
    radial-gradient(circle at 50% 52%, transparent 0 18%, rgba(0, 0, 0, 0.52) 38%, rgba(0, 0, 0, 0.92) 100%);
  mix-blend-mode: normal;
}

